# DHRUV Backend Environment Configuration
# Local development default:
DATABASE_URL=postgresql://dhruv_user:dhruv_password@localhost:5432/dhruv_db
# Cloud / Render deployment: DATABASE_URL is automatically provided by Render PostgreSQL (starting with postgres:// or postgresql://)

# Security (Generate a secure 64-char key in production)
SECRET_KEY=replace_with_random_secret_at_least_32_chars_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated, no wildcards when using credentials)
# In production, include your deployed frontend URL:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://dhruv-frontend.onrender.com
